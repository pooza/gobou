{
    "name": "pooza/gobou",
    "description": "PHP プロジェクト共通の PHP-CS-Fixer / PHPStan / phpcs の設定（ginseng-style の言語別の配布物）",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.29",
        "phpstan/phpstan": "2.3.5",
        "squizlabs/php_codesniffer": "3.13.6",
        "wp-coding-standards/wpcs": "3.4.1"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "archive": {
        "exclude": [
            "/test",
            "/node_modules",
            "/.github"
        ]
    }
}
